#!/bin/sh
#==========================================================
#  help — comandos de CarlOS 0.2 "Ruby of Sistem"
#  Formato en columnas alineadas.
#==========================================================
R='\033[38;5;196m'; W='\033[97m'; G='\033[38;5;245m'
D='\033[38;5;88m'; B='\033[48;5;236m'; X='\033[0m'

clear
printf "${B}${W} CarlOS 0.2 ${R}Ruby of Sistem ${W}- comandos ${X}\n\n"

# imprime 2 comandos por linea, alineados (cada uno: nombre 14 + desc)
row2() {
    printf "  ${W}%-13s${G}%-24s${W}%-13s${G}%s${X}\n" "$1" "$2" "$3" "$4"
}
row1() {
    printf "  ${W}%-13s${G}%s${X}\n" "$1" "$2"
}
head2() { printf "\n${R}%s${X}\n" "$1"; }

head2 "SISTEMA"
row2 "scfetch"    "info + logo"      "carlosinfo" "info detallada"
row2 "version"    "version"          "hardware"   "info hardware"
row2 "cpuinfo"    "cpu"              "meminfo"    "memoria"
row2 "diskinfo"   "discos"           "netinfo"    "red"

head2 "ESCRITORIO"
row1 "startc"     "escritorio EGT (ventanas + mouse)"

head2 "JUEGO Y AUDIO"
row2 "moskau"     "Tetris con musica" "moskau -m"  "mono limpio"
row2 "moskau -v"  "vol medio"        "moskau -vv" "vol bajo (-vvv susurro)"
row2 "moskau-sound" "solo musica"    "tuneplay"   "melodia buzzer"
row2 "tuneplay-p" "polifonia"     "buzzeroff"  "apaga buzzer"

head2 "VOZ"
row2 "buztts txt" "habla+subtitulos" "buztts -q"  "solo subtitulos"
row2 "buztts -f"  "lee archivo"      "echo|buztts" "pipe"

head2 "MORSE Y DIAGNOSTICO"
row2 "ascii2morse" "texto a morse"   "morsbep"    "morse a beep"
row2 "gpu-probe"  "grafico"          "alsa-probe" "audio"

printf "\n${G}+ comandos BusyBox: ls cat cp mv rm mkdir etc.${X}\n"
printf "${D}SC Co.${X}\n"
