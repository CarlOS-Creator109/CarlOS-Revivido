#!/bin/sh
#
# morsbep v0.1
# SC Co. Utilities
#

DEVICE="/dev/input/by-path/platform-pcspkr-event-spkr"

FREQ=700
DOT=80
DASH=240
GAP=80

VISUAL=0
AUTO=1

show_help() {

cat << EOF

morsbep v0.1
SC Co.

Uso:

morsbep [opciones] TEXTO

Opciones

-h --help        Mostrar ayuda
-v --visual      Mostrar el Morse
-p --pcspkr      Forzar PC Speaker
-a --auto        Auto detectar (default)
-f N             Frecuencia
-dot N           Duración punto
-dash N          Duración raya
-test            Probar buzzer

Ejemplos

morsbep HELLO
morsbep -visual SOS
morsbep -f 900 CARLOS

EOF

exit
}

test_beep(){

echo "Testing PC Speaker..."

beep -e "$DEVICE" -f "$FREQ" -l 250

exit
}

while [ $# -gt 0 ]
do
case "$1" in

-h|--help)
show_help
;;

-v|--visual)
VISUAL=1
;;

-f)
shift
FREQ="$1"
;;

-dot)
shift
DOT="$1"
;;

-dash)
shift
DASH="$1"
;;

-test)
test_beep
;;

*)
TEXT="$TEXT $1"
;;

esac

shift
done

TEXT=$(echo "$TEXT" | tr '[:lower:]' '[:upper:]')

MORSE=$(ascii2morse "$TEXT")

if [ "$VISUAL" = "1" ]; then
echo
echo "$TEXT"
echo
echo "$MORSE"
echo
fi

for c in $(echo "$MORSE" | sed 's/./& /g')
do

case "$c" in

.)
beep -e "$DEVICE" -f "$FREQ" -l "$DOT"
sleep 0.08
;;

-)
beep -e "$DEVICE" -f "$FREQ" -l "$DASH"
sleep 0.08
;;

"/")
sleep 0.5
;;

*)
sleep 0.15
;;

esac

done

